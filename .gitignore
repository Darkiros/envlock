# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# PyInstaller
build/
dist/
*.spec.bak

# Config locale de l'app (contient le hash du mot de passe)
config.json

# OS / éditeurs
.DS_Store
.idea/
.vscode/

# Le frontend Wails DOIT être versionné (assets embarqués dans le binaire),
# même si la règle générique 'dist/' ci-dessus voudrait l'exclure.
!go/frontend/dist/
!go/frontend/dist/**

# Icône de l'app Wails à versionner (sinon exclue par 'build/'), mais on garde
# la sortie de build (go/build/bin) ignorée.
!go/build/
!go/build/appicon.png
go/build/bin/
